{
  "info": {
    "name": "Finance API Contract",
    "_postman_id": "f9e7b38e-2b7e-45cd-b79d-4b9ac349de4b",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Upload Excel File",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response should be 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response should contain inserted and skipped counts', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('inserted');",
              "    pm.expect(jsonData).to.have.property('skipped');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "./postman_tests/test_data.xlsx"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/finances/upload/1/2025",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finances", "upload", "1", "2025"]
        }
      },
      "response": []
    },
    {
      "name": "Get Financial Records",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response should be 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response should be a valid JSON array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/finances/1/2025",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finances", "1", "2025"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ]
}
